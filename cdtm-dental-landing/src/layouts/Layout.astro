---
interface Props {
  title: string;
  description?: string;
  showFaq?: boolean;
  noindex?: boolean;
}

const { title, description = "Clinique Dentaire Temara Mall - Soins dentaires de qualité à Témara. Dr. SABAOUI Otmane et son équipe vous accueillent pour tous vos besoins dentaires.", showFaq = true, noindex = false } = Astro.props;

const siteUrl = "https://cliniquedentairetemaramall.com";
const ogImage = `${siteUrl}/logo.jpg`;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

// Structured data for Dentist/LocalBusiness
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  "name": "Clinique Dentaire Temara Mall (CDTM)",
  "alternateName": "عيادة أسنان تمارة مول",
  "description": "Cabinet dentaire moderne à Témara offrant des soins dentaires complets: implants, orthodontie, blanchiment, prothèses et soins préventifs.",
  "url": siteUrl,
  "logo": ogImage,
  "image": ogImage,
  "telephone": ["+212661530407", "+212537481383", "+212667670080"],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "4ème étage, Résidence Témara Mall 2, Bureau 16, Av. Hassan II",
    "addressLocality": "Témara",
    "addressCountry": "MA"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 33.9231675,
    "longitude": -6.9189915
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "09:00",
      "closes": "19:00"
    }
  ],
  "priceRange": "$$",
  "sameAs": ["https://www.instagram.com/clinique_dentaire_temara_mall"],
  "medicalSpecialty": ["Dentisterie", "Orthodontie", "Prothèse dentaire"],
  "availableService": [
    {"@type": "MedicalProcedure", "name": "Implants dentaires"},
    {"@type": "MedicalProcedure", "name": "Orthodontie"},
    {"@type": "MedicalProcedure", "name": "Blanchiment dentaire"},
    {"@type": "MedicalProcedure", "name": "Prothèses dentaires"},
    {"@type": "MedicalProcedure", "name": "Soins conservateurs"},
    {"@type": "MedicalProcedure", "name": "Urgences dentaires 24h/24"}
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5",
    "reviewCount": "100",
    "bestRating": "5"
  },
  "potentialAction": {
    "@type": "ReserveAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteUrl}/#contact`,
      "actionPlatform": [
        "http://schema.org/DesktopWebPlatform",
        "http://schema.org/MobileWebPlatform"
      ]
    },
    "result": {
      "@type": "Reservation",
      "name": "Rendez-vous dentaire"
    }
  },
  "paymentAccepted": ["Espèces", "Carte bancaire", "Chèque"],
  "currenciesAccepted": "MAD",
  "areaServed": [
    {"@type": "City", "name": "Témara"},
    {"@type": "City", "name": "Rabat"},
    {"@type": "City", "name": "Salé"},
    {"@type": "City", "name": "Skhirat"}
  ],
  "founder": {
    "@type": "Person",
    "name": "Dr. SABAOUI Otmane",
    "jobTitle": "Chirurgien-Dentiste"
  }
};

// FAQ Schema for Google Rich Results
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Quels sont les horaires de la clinique dentaire ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La clinique est ouverte 7 jours sur 7, de 9h à 19h, y compris le samedi et le dimanche. Service d'urgence disponible 24h/24."
      }
    },
    {
      "@type": "Question",
      "name": "Comment prendre rendez-vous ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Vous pouvez nous appeler au +212661530407, +212537481383 ou +212667670080, ou utiliser le formulaire de contact sur notre site."
      }
    },
    {
      "@type": "Question",
      "name": "Quels services dentaires proposez-vous ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nous offrons implants dentaires, orthodontie, blanchiment, prothèses dentaires, soins conservateurs et urgences dentaires 24h/24."
      }
    }
  ]
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://lh3.googleusercontent.com" />
    <meta name="description" content={description} />
    <meta name="keywords" content="dentiste, Témara, clinique dentaire, implants, orthodontie, blanchiment, soins dentaires, Temara Mall" />
    <meta name="author" content="Clinique Dentaire Temara Mall" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="fr_MA" />
    <meta property="og:site_name" content="Clinique Dentaire Temara Mall" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {showFaq && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

    <!-- Google Analytics 4 — deferred to not block rendering -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.addEventListener('load', function() {
        var s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-J0HTHN1P8Z';
        s.async = true;
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', 'G-J0HTHN1P8Z');
        // TODO: Add Google Ads conversion tag when ready
        // gtag('config', 'AW-XXXXXXXXX');
      });
    </script>

    <!-- Phone Click Tracking -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var pageVariant = window.location.pathname.includes('implants-b') ? 'B' : 'A';
        document.querySelectorAll('a[href^="tel:"]').forEach(function(link) {
          link.addEventListener('click', function() {
            gtag('event', 'phone_click', {
              'phone_number': this.href.replace('tel:', ''),
              'link_text': this.innerText.trim() || 'Phone Link',
              'link_location': this.closest('header') ? 'header' :
                               this.closest('footer') ? 'footer' :
                               this.closest('#contact-form') ? 'contact' : 'hero',
              'variant': pageVariant
            });
          });
        });
      });
    </script>

    <meta name="theme-color" content="#2563eb" />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <link rel="apple-touch-icon" href="/logo.jpg" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" /></noscript>
    <title>{title}</title>
  </head>
  <body class="font-sans antialiased text-gray-900 bg-white">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-primary: 37 99 235; /* medical blue RGB (blue-600) */
  }
  html {
    scroll-behavior: smooth;
  }
</style>
