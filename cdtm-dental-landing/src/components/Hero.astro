---
import { Image } from 'astro:assets';
import heroImage from '../assets/DSC00875-HDR-Large.jpg';
---

<section class="relative min-h-screen flex items-center pt-16 md:pt-20" aria-labelledby="hero-heading">
  <div class="absolute inset-0 z-0">
    <Image
      src={heroImage}
      alt="Intérieur moderne de la Clinique Dentaire Temara Mall"
      class="w-full h-full object-cover"
      loading="eager"
      format="webp"
      quality={80}
      widths={[640, 1024, 1920]}
      sizes="100vw"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-gray-900/85 to-gray-900/50"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-2xl">
      <h1 id="hero-heading" class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6 hero-title">
        Votre sourire mérite les
        <span class="hero-accent">meilleurs soins</span>
      </h1>
      <p class="text-lg md:text-xl text-gray-200 mb-8 hero-subtitle">
        La Clinique Dentaire Temara Mall vous accueille dans un cadre moderne et chaleureux.
        Dr. SABAOUI Otmane et son équipe sont à votre service pour des soins de qualité.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 hero-buttons">
        <a
          href="tel:0661530407"
          class="inline-flex items-center justify-center bg-primary-500 hover:bg-primary-600 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-colors"
          aria-label="Appeler pour prendre rendez-vous au 0661 53 04 07"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Prendre Rendez-vous
        </a>
        <a
          href="#services"
          class="inline-flex items-center justify-center border-2 border-white/80 text-white hover:bg-white hover:text-gray-900 px-8 py-4 rounded-lg font-semibold text-lg transition-colors"
        >
          Découvrir nos services
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-accent {
    background: linear-gradient(135deg, rgb(var(--color-primary)) 0%, rgb(96 165 250) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-title {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeSlideUp 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.3s forwards;
  }

  .hero-subtitle {
    opacity: 0;
    transform: translateY(25px);
    animation: fadeSlideUp 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.6s forwards;
  }

  .hero-buttons {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeSlideUp 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.9s forwards;
  }

  @keyframes fadeSlideUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-subtitle,
    .hero-buttons {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
