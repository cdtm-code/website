---
const testimonials = [
  {
    name: "Fatima Z.",
    text: "Excellente clinique ! Dr. Sabaoui est très professionnel et rassurant. Le personnel est accueillant et les locaux sont impeccables. Je recommande vivement !",
    rating: 5,
  },
  {
    name: "Ahmed M.",
    text: "J'avais très peur du dentiste mais l'équipe a su me mettre en confiance. Mes implants sont parfaits et je souris enfin sans complexe. Merci infiniment !",
    rating: 5,
  },
  {
    name: "Sarah L.",
    text: "Prise en charge rapide et efficace. Le docteur prend le temps d'expliquer chaque étape du traitement. Mes enfants adorent venir ici, c'est dire !",
    rating: 5,
  },
];
---

<section id="testimonials" class="py-20 bg-primary-500" aria-labelledby="testimonials-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 id="testimonials-heading" class="text-3xl md:text-4xl font-bold text-white mb-4">
        Ce que disent nos patients
      </h2>
      <p class="text-lg text-primary-100 max-w-2xl mx-auto">
        La satisfaction de nos patients est notre plus grande récompense.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {testimonials.map((testimonial) => (
        <article class="bg-white rounded-xl p-6 shadow-lg">
          <div class="flex gap-1 mb-4" aria-label={`Note : ${testimonial.rating} sur 5 étoiles`}>
            {Array(testimonial.rating).fill(null).map(() => (
              <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <blockquote class="text-gray-700 mb-4 italic">
            "{testimonial.text}"
          </blockquote>
          <p class="font-semibold text-gray-900">{testimonial.name}</p>
        </article>
      ))}
    </div>
  </div>
</section>
