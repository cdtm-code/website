---
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpg';
---

<header class="fixed top-0 left-0 right-0 bg-white/95 backdrop-blur-sm shadow-sm z-50">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Navigation principale">
    <div class="flex items-center justify-between h-16 md:h-20">
      <a href="#" class="flex items-center gap-2" aria-label="Accueil - Clinique Dentaire Temara Mall">
        <Image
          src={logo}
          alt="CDTM Logo"
          class="h-10 md:h-12 w-auto drop-shadow-sm rounded-lg"
          width={48}
          height={48}
          format="webp"
          quality={80}
        />
        <span class="hidden sm:inline text-gray-600 text-sm">Clinique Dentaire</span>
      </a>

      <div class="hidden md:flex items-center gap-8">
        <a href="#services" class="text-gray-600 hover:text-primary-500 transition-colors">Services</a>
        <a href="#about" class="text-gray-600 hover:text-primary-500 transition-colors">À propos</a>
        <a href="#testimonials" class="text-gray-600 hover:text-primary-500 transition-colors">Témoignages</a>
        <a href="#contact" class="text-gray-600 hover:text-primary-500 transition-colors">Contact</a>
      </div>

      <a
        href="tel:0661530407"
        class="bg-primary-500 hover:bg-primary-600 text-white px-4 py-2 rounded-lg font-medium transition-colors text-sm md:text-base"
        aria-label="Appeler pour prendre rendez-vous"
      >
        Prendre RDV
      </a>
    </div>
  </nav>
</header>
