---
import { Image } from 'astro:assets';
import external1 from '../assets/external1.png';
import external2 from '../assets/external2.png';
---

<section id="contact" class="py-20 bg-gray-50" aria-labelledby="contact-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 id="contact-heading" class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Contactez-nous
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Prenez rendez-vous dès aujourd'hui pour des soins dentaires de qualité.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <div class="space-y-8">
        <div class="flex items-start gap-4">
          <div class="bg-primary-500 text-white p-3 rounded-lg flex-shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-1">Adresse</h3>
            <p class="text-gray-600">4ème étage, Résidence Témara Mall 2<br />Bureau 16, Av. Hassan II<br />Témara, Maroc</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="bg-primary-500 text-white p-3 rounded-lg flex-shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-1">Téléphone</h3>
            <p class="text-gray-600">
              <a href="tel:0661530407" class="hover:text-primary-500 transition-colors">0661 53 04 07</a>
              <br />
              <a href="tel:0537481383" class="hover:text-primary-500 transition-colors">0537 48 13 83</a>
              <br />
              <a href="tel:0667670080" class="hover:text-primary-500 transition-colors">0667 67 00 80</a>
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="bg-primary-500 text-white p-3 rounded-lg flex-shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-1">Horaires</h3>
            <p class="text-gray-600">
              Lundi - Vendredi : 9h00 - 19h00<br />
              Samedi : 9h00 - 13h00<br />
              Dimanche : Fermé
            </p>
            <p class="text-primary-600 font-semibold mt-2">
              Service d'urgence : 24h/24
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="bg-primary-500 text-white p-3 rounded-lg flex-shrink-0">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-1">Instagram</h3>
            <a
              href="https://instagram.com/clinique_dentaire_temara_mall"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary-500 hover:text-primary-600 transition-colors"
            >
              @clinique_dentaire_temara_mall
            </a>
          </div>
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="font-semibold text-gray-900 mb-2">Comment nous trouver</h3>
        <div class="grid grid-cols-2 gap-3">
          <Image
            src={external1}
            alt="Vue extérieure de la Résidence Témara Mall 2"
            class="rounded-lg object-cover w-full h-32 shadow-md"
            loading="lazy"
            format="webp"
            quality={80}
            widths={[300, 600]}
            sizes="50vw"
          />
          <Image
            src={external2}
            alt="Entrée du bâtiment Témara Mall 2"
            class="rounded-lg object-cover w-full h-32 shadow-md"
            loading="lazy"
            format="webp"
            quality={80}
            widths={[300, 600]}
            sizes="50vw"
          />
        </div>
        <div class="h-64 rounded-xl overflow-hidden shadow-lg">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3323.5!2d-6.9215664!3d33.9231675!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xda7130016831f21%3A0x7643611541bf5528!2sClinique%20Dentaire%20Temara%20Mall!5e0!3m2!1sfr!2sma!4v1"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Localisation de la Clinique Dentaire Temara Mall sur Google Maps"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>
